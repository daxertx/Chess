<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_IChessService" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:8733/ChessService/" binding="basicHttpBinding"
                bindingConfiguration="BasicHttpBinding_IChessService" contract="ChessServer.IChessService"
                name="BasicHttpBinding_IChessService" />
        </client>
    </system.serviceModel>
</configuration>
