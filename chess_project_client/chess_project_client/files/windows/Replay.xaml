<Window x:Class="chess_project_client.files.windows.Replay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:chess_project_client.files.windows"
        mc:Ignorable="d"
        Title="Replay" Height="760" Width="720"
        MinHeight="460" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        Background="#262421"
        Focusable="True"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText"
                   Grid.Row="0"
                   Text=""
                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#E8E6E3"/>

        <Viewbox x:Name="boardBox" Grid.Row="0" Margin="24" Stretch="Uniform" Visibility="Collapsed">
            <Border Padding="14" CornerRadius="4" Background="#3A3734">
                <Border BorderBrush="#201E1C" BorderThickness="2">
                    <Grid x:Name="board" Width="640" Height="640">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                    </Grid>
                </Border>
            </Border>
        </Viewbox>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,0,0,18">
            <Button x:Name="FirstButton" Content="|&lt;" Width="52" Height="34" Margin="4,0"
                    Click="First_Click"/>
            <Button x:Name="BackButton" Content="&lt; Back" Width="86" Height="34" Margin="4,0"
                    Click="Back_Click"/>
            <TextBlock x:Name="MoveText" Text="" Width="132" Height="34"
                       TextAlignment="Center" VerticalAlignment="Center" Padding="0,7,0,0"
                       FontSize="14" Foreground="#E8E6E3"/>
            <Button x:Name="NextButton" Content="Next &gt;" Width="86" Height="34" Margin="4,0"
                    Click="Next_Click"/>
            <Button x:Name="LastButton" Content="&gt;|" Width="52" Height="34" Margin="4,0"
                    Click="Last_Click"/>
        </StackPanel>
    </Grid>
</Window>
