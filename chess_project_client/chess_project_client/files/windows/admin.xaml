<Window x:Class="chess_project_client.files.windows.admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:chess_project_client.files.windows"
        mc:Ignorable="d"
        Title="Chess Admin Panel" Height="680" Width="740"
        WindowStartupLocation="CenterScreen" Background="#F4EFEA">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFDFB"/>
            <Setter Property="BorderBrush" Value="#8B5A2B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="5,2,5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="WoodButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5C3A21"/>
            <Setter Property="Foreground" Value="#F4EFEA"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#70472D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResetButtonStyle" TargetType="Button" BasedOn="{StaticResource WoodButtonStyle}">
            <Setter Property="Background" Value="#A07855"/>
            <Setter Property="Foreground" Value="#332211"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B88E69"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderThickness="15" CornerRadius="0">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3E2723" Offset="0.0"/>
                <GradientStop Color="#5D4037" Offset="0.5"/>
                <GradientStop Color="#3E2723" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="520" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="דף מנהל - צור משתמש" FontSize="26" FontWeight="Bold" Foreground="#3E2723"/>
                <Border Height="2" Background="#8B5A2B" Width="150" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,0,12" FlowDirection="RightToLeft">
                <TextBlock Text="שם משתמש:" FontSize="16" FontWeight="SemiBold" Foreground="#4E342E" Margin="0,0,0,5"/>
                <TextBox x:Name="username" Height="35"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,0,0,12" FlowDirection="RightToLeft">
                <TextBlock Text="סיסמה:" FontSize="16" FontWeight="SemiBold" Foreground="#4E342E" Margin="0,0,0,5"/>
                <TextBox x:Name="password" Height="35"/>
            </StackPanel>

            <CheckBox x:Name="isAdmin" Content="הרשאות מנהל מערכת" Grid.Column="1" Grid.Row="3"
                      Margin="0,5,0,15" FontSize="16" Foreground="#4E342E" FontWeight="SemiBold"
                      HorizontalAlignment="Right" FlowDirection="RightToLeft" VerticalAlignment="Center"/>

            <Button Content="צור משתמש חדש" Style="{StaticResource WoodButtonStyle}"
                    Grid.Column="1" Grid.Row="4" Width="250" Height="40"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="createuser">
                <Button.Effect>
                    <DropShadowEffect Color="#333333" BlurRadius="5" ShadowDepth="2" Opacity="0.5"/>
                </Button.Effect>
            </Button>

            <Button Content="אפס שדות" Style="{StaticResource ResetButtonStyle}"
                    Grid.Column="1" Grid.Row="5" Width="150" Height="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Click="reset"/>

            <!-- Users table at the bottom -->
            <Grid Grid.Column="1" Grid.Row="6" Margin="0,12,0,0" FlowDirection="RightToLeft">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="טבלת כל המשתמשים:" FontSize="18" FontWeight="Bold"
                           Foreground="#3E2723" Margin="0,0,0,6"/>

                <DataGrid Grid.Row="1" x:Name="UsersGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Background="#FFFDFB"
                          RowBackground="#FFFDFB"
                          AlternatingRowBackground="#F4EFEA"
                          BorderBrush="#8B5A2B"
                          BorderThickness="1.5"
                          FontSize="14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="מזהה" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="שם משתמש" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="סיסמה" Binding="{Binding Password}" Width="*"/>
                        <DataGridTextColumn Header="מנהל מערכת" Binding="{Binding IsAdminText}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Border>
</Window>
