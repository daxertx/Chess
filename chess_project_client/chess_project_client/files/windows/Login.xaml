<Window x:Class="chess_project_client.files.windows.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chess — Sign in"
        Height="460" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D0D0D">

    <Window.Resources>
        <Style x:Key="FieldStyle" TargetType="Control">
            <Setter Property="Height"           Value="34"/>
            <Setter Property="FontSize"         Value="14"/>
            <Setter Property="Background"       Value="#1C1C1C"/>
            <Setter Property="Foreground"       Value="#F0EDE6"/>
            <Setter Property="BorderBrush"      Value="#2E2E2E"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="6,0,0,0"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Foreground"      Value="#0D0D0D"/>
            <Setter Property="Background"      Value="#C9A84C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#DCBB5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#C9A84C"/>
            <Setter Property="Background" Value="#1C1C1C"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="34,30,34,0">

        <TextBlock Text="♚" FontSize="44" Foreground="#C9A84C"
                   HorizontalAlignment="Center" Margin="0,0,0,6"/>

        <TextBlock Text="CHESS" FontSize="30" FontWeight="Bold" Foreground="#F0EDE6"
                   HorizontalAlignment="Center" FontFamily="Georgia, serif"/>

        <TextBlock Text="sign in to play" FontSize="11" Foreground="#5A5652"
                   HorizontalAlignment="Center" FontFamily="Georgia, serif" Margin="0,4,0,22"/>

        <TextBlock Text="Username" Foreground="#7A7672" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="UsernameBox" Style="{StaticResource FieldStyle}"
                 KeyDown="Field_KeyDown"/>

        <TextBlock Text="Password" Foreground="#7A7672" FontSize="12" Margin="0,14,0,4"/>
        <PasswordBox x:Name="PasswordBox" Style="{StaticResource FieldStyle}"
                     KeyDown="Field_KeyDown"/>

        <TextBlock x:Name="MessageText" Text="" Foreground="#D96459"
                   FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="32"/>

        <Button x:Name="LoginButton" Content="Log in"
                Style="{StaticResource ActionButton}" Click="Login_Click" IsDefault="True"/>

        <Button x:Name="RegisterButton" Content="Create an account"
                Style="{StaticResource GhostButton}" Margin="0,10,0,0" Click="Register_Click"/>
    </StackPanel>
</Window>
