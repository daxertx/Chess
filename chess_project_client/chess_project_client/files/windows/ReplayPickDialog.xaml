<Window x:Class="chess_project_client.files.windows.ReplayPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watch Replay"
        Width="560" Height="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        Background="#161616">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pick a game to watch"
                   Foreground="#F0EDE6" FontSize="16" Margin="0,0,0,10"/>

        <ListBox x:Name="GamesList" Grid.Row="1"
                 Background="#1C1C1C" Foreground="#F0EDE6" BorderBrush="#2E2E2E"
                 FontSize="13"
                 MouseDoubleClick="GamesList_DoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,4"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <TextBlock x:Name="EmptyText" Grid.Row="1"
                   Text="No games saved yet."
                   Foreground="#7A7672" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Text="" Foreground="#D96459"
                   FontSize="12" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Refresh" Width="84" Height="30" Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="Cancel"  Width="84" Height="30" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Watch"   Width="84" Height="30" Click="Watch_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
