<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Phone_App.files.pages.Register"
             Title="Register">
    <VerticalStackLayout>

        <Entry 
        Placeholder="שם משתמש" 
        TextColor="Black"
        FontSize="Medium"
        ClearButtonVisibility="WhileEditing"
        x:Name="username"/>

        <Entry 
    Placeholder="סיסמה" 
    TextColor="Black"
    FontSize="Medium"
    ClearButtonVisibility="WhileEditing" 
    x:Name="password"/>

        <Button Text="הרשמה" Clicked="try_Register"></Button>

    </VerticalStackLayout>
</ContentPage>