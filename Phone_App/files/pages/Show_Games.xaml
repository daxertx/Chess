<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ChessServer"
             x:Class="Phone_App.files.pages.Show_Games"
             Title="המשחקים שלי"
             BackgroundColor="{StaticResource Gray100}"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0"
               Text="היסטוריית משחקים"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="{StaticResource Gray900}"
               Padding="20,16" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Games}"
                        Margin="12,0,12,12">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Game_Data">
                    <Border BackgroundColor="White"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 16"
                            Padding="16"
                            Margin="0,6">
                        <VerticalStackLayout Spacing="6">

                            <Label Text="{Binding player_won, StringFormat='🏆 מנצח: {0}'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />

                            <Label Text="{Binding player_lost, StringFormat='מפסיד: {0}'}"
                                   FontSize="14"
                                   TextColor="{StaticResource Gray500}" />

                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0"
                                       Text="{Binding amount_of_moves, StringFormat='מהלכים: {0}'}"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray600}" />
                                <Label Grid.Column="1"
                                       Text="{Binding date}"
                                       FontSize="13"
                                       HorizontalOptions="End"
                                       TextColor="{StaticResource Gray400}" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="אין עדיין משחקים להצגה"
                       FontSize="16"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{StaticResource Gray500}" />
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>
</ContentPage>
